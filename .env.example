# Rift Service Configuration

# SSH server address (default: :2222)
SSH_ADDR=:2222

# HTTP proxy address (default: :8080)
HTTP_ADDR=:8080

# Base domain for rifts (default: localhost)
BASE_DOMAIN=localhost

# Log level: debug, info, warn, error (default: info)
LOG_LEVEL=info

# SSH idle timeout (default: 300s)
# Examples: 5m, 300s, 1h
IDLE_TIMEOUT=300s

# SSH max timeout (default: 50m)
MAX_TIMEOUT=50m

# rift cleanup interval (default: 5m)
CLEANUP_INTERVAL=5m

# Subdomain length (default: 8)
SUBDOMAIN_LENGTH=8
